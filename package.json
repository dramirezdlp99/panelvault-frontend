{
  "name": "panelvault-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend de PanelVault: biblioteca de comics offline-first con lectura guiada por vinetas",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
