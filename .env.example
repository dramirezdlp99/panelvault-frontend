# Copia este archivo como .env.local para desarrollo. Los .env reales NUNCA se suben a Git.

# URL publica del frontend (se usa en metadatos y enlaces absolutos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL del backend de Spring Boot. Solo la usa el servidor de Next (nunca el navegador).
PANELVAULT_API_URL=http://localhost:9096

# Secreto HMAC compartido con el backend (minimo 32 caracteres). Debe ser el MISMO valor
# que PANELVAULT_GATEWAY_SECRET del backend. Dejalo vacio si el backend tiene el gateway apagado.
PANELVAULT_GATEWAY_SECRET=

# Opcional: fuerza cookies Secure (true) o no (false). Por defecto: true solo en produccion.
# PANELVAULT_SECURE_COOKIES=false
